{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://table-to-chart.local/schemas/project-v1.json",
  "title": "Table to Chart Pro Project",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "metadata", "data", "chart"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "metadata": {
      "type": "object",
      "required": ["name", "updatedAt"],
      "properties": { "name": { "type": "string" }, "updatedAt": { "type": "string", "format": "date-time" } }
    },
    "data": {
      "type": "object",
      "required": ["headers", "rows"],
      "properties": {
        "headers": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "rows": { "type": "array", "minItems": 1, "items": { "type": "array", "items": { "type": "string" } } }
      }
    },
    "chart": { "type": "object", "required": ["type", "theme", "title"], "additionalProperties": true }
  }
}
